<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HDD_Index.App"
             xmlns:local="using:HDD_Index"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <Style Selector=":is(Window)">
            <Setter Property="Icon" Value="avares://HDD-Index/Assets/hdd-index.ico" />
        </Style>
        <StyleInclude 
            Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Fluent.axaml"/>
        <StyleInclude Source="/Styles/Workspace.axaml" />
    </Application.Styles>
</Application>
