<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HDD_Index.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="260"
        x:Class="HDD_Index.Views.ConfirmMessageDialog"
        x:DataType="vm:ConfirmMessageDialogViewModel"
        Title="确认"
        Width="520" Height="260"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:ConfirmMessageDialogViewModel />
    </Design.DataContext>

    <Grid Margin="14" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" />
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Command="{Binding CancelCommand}" />
            <Button Content="确定"
                    Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</Window>
