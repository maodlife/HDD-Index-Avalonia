<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HDD_Index.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:HDD_Index.Views.Behaviors"
        xmlns:views="clr-namespace:HDD_Index.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HDD_Index.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="HDD_Index">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>
    
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="_File">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="New File Tree"
                                        Command="{Binding OpenCreateNewFileTreeDialog}"/>
                        <NativeMenuItem Header="Save All to Json Files" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <TabControl Margin="5"
                SelectedIndex="{Binding ViewModeTabIndex}">
        <TabItem Header="浏览">
            <TabControl Margin="0">
                <TabItem Header="Repository">
                    <Grid Margin="20" RowDefinitions="Auto, *">
                        <TextBox Grid.Row="0"
                                 Text="{Binding RepoNodePathString}">
                        </TextBox>
                        <TreeDataGrid Grid.Row="1"
                                      Name="{x:Static views:ControlNames.ViewRepoTree}"
                                      Source="{Binding RepoNodeSource}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <Interaction.Behaviors>
                                <behaviors:ScrollToSelectedItemBehavior />
                            </Interaction.Behaviors>
                        </TreeDataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="硬盘">
                    <Grid
                        Grid.Column="1"
                        Margin="20"
                        RowDefinitions="Auto,*,Auto">
                        <ComboBox Grid.Row="0"
                                  ItemsSource="{Binding DiskLabels}"
                                  SelectedItem="{Binding SelectedDiskLabel}">
                        </ComboBox>
                        <TreeDataGrid Grid.Row="1"
                                      Name="{x:Static views:ControlNames.ViewFileTree}"
                                      Source="{Binding CurrFileNodeSource}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <Interaction.Behaviors>
                                <behaviors:ScrollToSelectedItemBehavior />
                            </Interaction.Behaviors>
                        </TreeDataGrid>

                    </Grid>
                </TabItem>
            </TabControl>
        </TabItem>
        <TabItem Header="编辑">
            <Grid Margin="20" ColumnDefinitions="*, *">
                <Grid Margin="20" RowDefinitions="*,Auto">
                    <TreeDataGrid
                        Name="{x:Static views:ControlNames.EditRepoTree}"
                        Source="{Binding RepoNodeSource}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <Interaction.Behaviors>
                            <behaviors:ScrollToSelectedItemBehavior />
                        </Interaction.Behaviors>
                    </TreeDataGrid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*, *">
                        <TextBox Text="保存了该节点的磁盘:"></TextBox>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CurrRepoNodeSaveFileNodes}"
                                  SelectedItem="{Binding SelectedSaveFileNodeLabel}">
                        </ComboBox>
                        <Button Grid.Column="2"
                                Content="跳转"
                                Command="{Binding JumpToCurrSelectSaveFileNode}">
                        </Button>
                        <CheckBox Grid.Column="3"
                                  Content="自动跳转"
                                  IsChecked="{Binding AutoJumpToSaveFileNode}">
                        </CheckBox>
                    </Grid>
                </Grid>

                <Grid
                    Grid.Column="1"
                    Margin="20"
                    RowDefinitions="Auto,*,Auto">
                    <ComboBox Grid.Row="0"
                              ItemsSource="{Binding DiskLabels}"
                              SelectedItem="{Binding SelectedDiskLabel}">
                    </ComboBox>
                    <TreeDataGrid Grid.Row="1"
                                  Name="{x:Static views:ControlNames.EditFileTree}"
                                  Source="{Binding CurrFileNodeSource}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <Interaction.Behaviors>
                            <behaviors:ScrollToSelectedItemBehavior />
                        </Interaction.Behaviors>
                    </TreeDataGrid>
                    <Grid Grid.Row="2">
                        <CheckBox Content="自动跳转到持有的节点"
                                  IsChecked="{Binding AutoJumpToDeclareRepoNode}">
                        </CheckBox>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>

</Window>