<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HDD_Index.ViewModels"
        xmlns:views="using:HDD_Index.Views"
        xmlns:behaviors="clr-namespace:HDD_Index.Views.Behaviors"
        xmlns:messages="clr-namespace:HDD_Index.Messages"
        x:Class="HDD_Index.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1360" Height="860" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WorkspaceBackground}"
        Title="HDD Index">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
    </Window.KeyBindings>
    <Window.Resources>
        <views:VisibleTreeSourceConverter x:Key="VisibleTreeSourceConverter" />

    </Window.Resources>

    <Grid RowDefinitions="60,*">
        <!-- Keep the operating system's real title bar and window controls. -->
        <Border Classes="toolbar" Grid.Row="0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="224,*,224" Margin="20,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <views:NodeIcon Kind="Disk" Width="20" Height="23" />
                    <TextBlock Text="HDD Index" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Classes="segment" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <RadioButton Classes="mode" GroupName="WorkspaceMode" Theme="{StaticResource {x:Type ToggleButton}}"
                                     IsChecked="{Binding IsBrowseMode, Mode=OneWay}" Content="浏览"
                                Command="{Binding ShowBrowseCommand}" AutomationProperties.Name="浏览模式" />
                        <RadioButton Classes="mode" GroupName="WorkspaceMode" Theme="{StaticResource {x:Type ToggleButton}}"
                                     IsChecked="{Binding IsOrganizeMode, Mode=OneWay}" Content="整理"
                                Command="{Binding ShowOrganizeCommand}" AutomationProperties.Name="整理模式" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SaveStatusText}" Classes="secondary" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Command="{Binding SaveCommand}" ToolTip.Tip="保存修改 (Ctrl / ⌘ + S)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:NodeIcon Kind="Save" Width="17" Height="17" />
                            <TextBlock Text="保存" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="224,*">
            <Border Grid.Column="0" Classes="sidebar" BorderThickness="0,0,1,0">
                <Grid Margin="12,20,12,12" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <TextBlock Text="资料库" Classes="section-label" Margin="12,0,0,9" />
                    <Button Grid.Row="1" Classes="navigation" Classes.active="{Binding IsRepositorySelected}"
                            Command="{Binding SelectRepositoryCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <views:NodeIcon Kind="Folder" Stroke="{DynamicResource WorkspaceAccent}" Width="23" Height="23" />
                            <TextBlock Text="Repository" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="2" Text="磁盘索引" Classes="section-label" Margin="12,25,0,9" />
                    <ListBox Grid.Row="3" Classes="disks" ItemsSource="{Binding FileBrowser.DiskLabels}"
                             SelectedItem="{Binding SelectedSidebarDiskLabel}"
                             AutomationProperties.Name="磁盘索引">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <views:NodeIcon Kind="Disk" Width="23" Height="27" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="4" Classes="navigation" Command="{Binding OpenCreateNewFileTreeDialogCommand}"
                            HorizontalAlignment="Stretch" Margin="0,12,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <views:NodeIcon Kind="Plus" Width="22" Height="22" />
                            <TextBlock Text="添加索引" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="5" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,1,0,0" Padding="10,12,10,0">
                        <TextBlock Text="仅管理索引，不移动磁盘文件" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="68,*,36">
                <Border Grid.Row="0" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid>
                            <TextBox Name="RepositorySearch" Classes="search" Watermark="搜索 Repository"
                                     Padding="43,9,66,9"
                                     Text="{Binding RepoBrowser.RepoSearch.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="搜索 Repository 中的文件或目录" />
                            <views:NodeIcon Kind="Search" Width="19" Height="19" Margin="14,0,0,0"
                                            HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Classes="secondary" IsHitTestVisible="False"
                                       Text="{Binding RepoBrowser.RepoSearch.MatchCounterText}" />
                        </Grid>
                        <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="{DynamicResource WorkspaceBorder}"
                                BorderThickness="1" CornerRadius="8" Background="{DynamicResource WorkspaceSurface}">
                            <Grid ColumnDefinitions="Auto,1,Auto">
                                <Button Classes="search-step" Command="{Binding RepoBrowser.RepoSearch.SearchPreviousCommand}"
                                        IsEnabled="{Binding RepoBrowser.RepoSearch.HasMatches}" ToolTip.Tip="上一个搜索结果" AutomationProperties.Name="上一个搜索结果">
                                    <views:NodeIcon Kind="ChevronUp" Width="14" Height="14" />
                                </Button>
                                <Border Grid.Column="1" Background="{DynamicResource WorkspaceBorder}" Margin="0,8" />
                                <Button Grid.Column="2" Classes="search-step" Command="{Binding RepoBrowser.RepoSearch.SearchNextCommand}"
                                        IsEnabled="{Binding RepoBrowser.RepoSearch.HasMatches}" ToolTip.Tip="下一个搜索结果" AutomationProperties.Name="下一个搜索结果">
                                    <views:NodeIcon Kind="ChevronDown" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,320" IsVisible="{Binding IsRepositoryBrowseVisible}">
                    <Grid RowDefinitions="78,*">
                        <StackPanel Margin="24,11" Spacing="5">
                            <TextBlock Text="虚拟目录" Classes="heading" />
                            <TextBlock Text="{Binding RepoBrowser.RepoNodePathString}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Row="1"><TreeDataGrid Name="{x:Static messages:TreeControlNames.ViewRepoTree}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeDataGrid.Source>
                <MultiBinding Converter="{StaticResource VisibleTreeSourceConverter}">
                    <Binding Path="RepoBrowser.RepoNodeSource" />
                    <Binding Path="IsRepositoryBrowseVisible" />
                </MultiBinding>
            </TreeDataGrid.Source>
            <Interaction.Behaviors>
                <behaviors:ScrollToSelectedItemBehavior />
                <behaviors:TreeViewportBehavior />
            </Interaction.Behaviors>
            <TreeDataGrid.ContextMenu><views:NodeContextMenu /></TreeDataGrid.ContextMenu>
        </TreeDataGrid></Border>
                    </Grid>
                    <Border Grid.Column="1" Classes="inspector" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="28,28,24,24" Spacing="22">
                                <Grid Width="76" Height="76" HorizontalAlignment="Left">
                                    <views:NodeIcon Kind="Folder" Stroke="{DynamicResource WorkspaceMuted}" StrokeThickness="3" IsVisible="{Binding RepoBrowser.CurrentRepoNodeIsDirectory}" />
                                    <views:NodeIcon Kind="File" Stroke="{DynamicResource WorkspaceMuted}" StrokeThickness="3" IsVisible="{Binding !RepoBrowser.CurrentRepoNodeIsDirectory}" />
                                </Grid>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding RepoBrowser.CurrentRepoNodeName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RepoBrowser.CurrentRepoNodeKind}" Classes="secondary" />
                                </StackPanel>
                                <Separator />
                                <StackPanel Spacing="12" IsVisible="{Binding RepoBrowser.HasCurrentRepoNode}">
                                    <TextBlock Text="验证策略" FontWeight="SemiBold" />
                                    <views:StrategySelector />
                                </StackPanel>
                                <Separator />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="存储位置" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RepoBrowser.StorageLocationCount}" Classes="secondary" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding RepoBrowser.CurrentStorageLocations}">
                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:StorageLocationViewModel">
    <Button Classes="location" HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Command="{Binding $parent[Window].DataContext.ShowStorageLocationCommand}"
            CommandParameter="{Binding}" ToolTip.Tip="在磁盘索引中显示">
        <Grid ColumnDefinitions="30,*,16">
            <views:NodeIcon Kind="Disk" Width="27" Height="32" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1" Margin="12,0,12,0" Spacing="4">
                <TextBlock Text="{Binding DiskLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DisplayPath}" Classes="secondary" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding DisplayPath}" />
                <TextBlock Text="在磁盘索引中显示 →" Classes="link" FontSize="13" />
            </StackPanel>
            <views:NodeIcon Grid.Column="2" Kind="ChevronRight" Width="14" Height="14" />
        </Grid>
    </Button>
</DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="整理关联  →" Command="{Binding ShowOrganizeCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" IsVisible="{Binding IsDiskBrowseVisible}" RowDefinitions="78,*" ColumnDefinitions="*,280">
                    <StackPanel Margin="24,11" Spacing="5">
                        <TextBlock Text="{Binding FileBrowser.SelectedDiskLabel}" Classes="heading" />
                        <TextBlock Text="磁盘文件索引" Classes="secondary" />
                    </StackPanel>
                    <Border Grid.Row="1"><TreeDataGrid Name="{x:Static messages:TreeControlNames.ViewFileTree}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeDataGrid.Source>
                <MultiBinding Converter="{StaticResource VisibleTreeSourceConverter}">
                    <Binding Path="FileBrowser.CurrFileNodeSource" />
                    <Binding Path="IsDiskBrowseVisible" />
                </MultiBinding>
            </TreeDataGrid.Source>
            <Interaction.Behaviors>
                <behaviors:ScrollToSelectedItemBehavior />
                <behaviors:TreeViewportBehavior />
            </Interaction.Behaviors>
            <TreeDataGrid.ContextMenu><views:NodeContextMenu /></TreeDataGrid.ContextMenu>
        </TreeDataGrid></Border>
                    <Border Grid.Column="1" Grid.RowSpan="2" Classes="inspector" BorderThickness="1,0,0,0" Padding="24">
                        <StackPanel Spacing="18">
                            <views:NodeIcon Kind="Disk" Width="58" Height="70" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding FileBrowser.SelectedDiskLabel}" Classes="heading" TextWrapping="Wrap" />
                            <TextBlock Text="查看已扫描的目录结构。右键节点可刷新索引、查看关联或在文件夹中打开。" Classes="secondary" TextWrapping="Wrap" />
                            <Separator />
                            <Button Content="打开文件夹" Command="{Binding RepositoryEditor.OpenCurrentFileDataFolderCommand}"
                                    IsEnabled="{Binding FileBrowser.HasCurrentLocalFolderPath}" HorizontalAlignment="Stretch" />
                            <Button Content="修复本地路径" Command="{Binding RepositoryEditor.RepairCurrentFileDataPathCommand}"
                                    IsEnabled="{Binding FileBrowser.HasCurrentFileData}" HorizontalAlignment="Stretch" />
                            <Button Content="整理关联  →" Command="{Binding ShowOrganizeCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" IsVisible="{Binding IsOrganizeMode}" RowDefinitions="*,140,70">
                    <Grid ColumnDefinitions="*,5,*">
                        <Grid RowDefinitions="78,*" MinWidth="330">
                            <StackPanel Margin="24,11" Spacing="5">
                                <TextBlock Text="虚拟目录" Classes="heading" />
                                <TextBlock Text="{Binding RepoBrowser.RepoNodePathString}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Row="1"><TreeDataGrid Name="{x:Static messages:TreeControlNames.EditRepoTree}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeDataGrid.Source>
                <MultiBinding Converter="{StaticResource VisibleTreeSourceConverter}">
                    <Binding Path="RepoBrowser.RepoNodeSource" />
                    <Binding Path="IsOrganizeMode" />
                </MultiBinding>
            </TreeDataGrid.Source>
            <Interaction.Behaviors>
                <behaviors:ScrollToSelectedItemBehavior />
                <behaviors:TreeViewportBehavior />
            </Interaction.Behaviors>
            <TreeDataGrid.ContextMenu><views:NodeContextMenu /></TreeDataGrid.ContextMenu>
        </TreeDataGrid></Border>
                        </Grid>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent">
                            <GridSplitter.Template><ControlTemplate><Border Background="Transparent"><Border Width="1" Background="{DynamicResource WorkspaceBorder}" /></Border></ControlTemplate></GridSplitter.Template>
                        </GridSplitter>
                        <Grid Grid.Column="2" RowDefinitions="78,*" MinWidth="330">
                            <Grid Margin="20,12" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="磁盘文件索引" Classes="heading" />
                                    <TextBlock Text="右键节点以刷新或管理关联" Classes="secondary" FontSize="11" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                          ItemsSource="{Binding FileBrowser.DiskLabels}" SelectedItem="{Binding FileBrowser.SelectedDiskLabel}"
                                          AutomationProperties.Name="整理模式的磁盘索引" />
                            </Grid>
                            <Border Grid.Row="1"><TreeDataGrid Name="{x:Static messages:TreeControlNames.EditFileTree}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeDataGrid.Source>
                <MultiBinding Converter="{StaticResource VisibleTreeSourceConverter}">
                    <Binding Path="FileBrowser.CurrFileNodeSource" />
                    <Binding Path="IsOrganizeMode" />
                </MultiBinding>
            </TreeDataGrid.Source>
            <Interaction.Behaviors>
                <behaviors:ScrollToSelectedItemBehavior />
                <behaviors:TreeViewportBehavior />
            </Interaction.Behaviors>
            <TreeDataGrid.ContextMenu><views:NodeContextMenu /></TreeDataGrid.ContextMenu>
        </TreeDataGrid></Border>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="1" Classes="inspector" BorderThickness="0,1,0,1" Padding="24,12">
                        <Grid ColumnDefinitions="*,1,*">
                            <Grid ColumnDefinitions="84,*" Margin="0,0,20,0">
                                <Grid Width="64" Height="64" HorizontalAlignment="Left">
                                    <views:NodeIcon Kind="Folder" Stroke="{DynamicResource WorkspaceMuted}" StrokeThickness="3" IsVisible="{Binding RepoBrowser.CurrentRepoNodeIsDirectory}" />
                                    <views:NodeIcon Kind="File" Stroke="{DynamicResource WorkspaceMuted}" StrokeThickness="3" IsVisible="{Binding !RepoBrowser.CurrentRepoNodeIsDirectory}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                                    <TextBlock Text="{Binding RepoBrowser.CurrentRepoNodeName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding RepoBrowser.HasCurrentRepoNode}">
                                        <TextBlock Text="验证策略" VerticalAlignment="Center" Classes="secondary" />
                                        <views:StrategySelector />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Column="1" Background="{DynamicResource WorkspaceBorder}" />
                            <Grid Grid.Column="2" Margin="24,0,0,0" RowDefinitions="Auto,*">
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                                    <TextBlock Text="存储位置" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RepoBrowser.StorageLocationCount}" Classes="secondary" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RepoBrowser.CurrentStorageLocations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StorageLocationViewModel">
                                                <Button Classes="location compact" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[Window].DataContext.ShowStorageLocationCommand}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="在磁盘索引中显示">
                                                    <Grid ColumnDefinitions="22,*,14">
                                                        <views:NodeIcon Kind="Disk" Width="19" Height="21" />
                                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" Margin="10,0">
                                                            <TextBlock Text="{Binding DiskLabel}" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="/" Classes="secondary" Margin="8,0" />
                                                            <TextBlock Grid.Column="2" Text="{Binding DisplayPath}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                        <views:NodeIcon Grid.Column="2" Kind="ChevronRight" Width="12" Height="12" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="20,8" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <CheckBox Content="自动定位存储位置" IsChecked="{Binding RepositoryEditor.AutoJumpToSaveFileNode}" MinHeight="26" FontSize="12" />
                            <CheckBox Content="自动定位关联目录" IsChecked="{Binding RepositoryEditor.AutoJumpToDeclareRepoNode}" MinHeight="26" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="10,0">
                            <Button Content="复制目录结构" Command="{Binding RepositoryEditor.CopySelectedFileNodeToRepoNodeCommand}"
                                    CommandParameter="{Binding RepoBrowser.CurrentRepoNode}" IsEnabled="{Binding CanCopySelectedStructure}"
                                    ToolTip.Tip="把右侧选中节点的索引结构复制到左侧选中的目录，不复制磁盘文件" />
                            <TextBlock Text="仅复制索引结构" Classes="secondary" FontSize="10" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="primary" Content="建立关联" VerticalAlignment="Top" Margin="0,3,0,0"
                                Command="{Binding RepositoryEditor.DeclareSelectedRepoNodeCommand}"
                                CommandParameter="{Binding FileBrowser.CurrFileNodeSource.RowSelection.SelectedItem}"
                                IsEnabled="{Binding CanLinkSelectedNodes}" ToolTip.Tip="按验证策略关联左右选中节点，不移动磁盘文件" />
                    </Grid>
                </Grid>
                <Border Grid.Row="2" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,1,0,0" Padding="20,3">
                    <Grid ColumnDefinitions="18,*,Auto">
                        <views:NodeIcon Kind="Folder" Width="15" Height="15" />
                        <TextBox Grid.Column="1" Name="RepositoryAddress" Classes="address"
                                 Text="{Binding RepoBrowser.RepoNodePathString, Mode=OneWay}" KeyDown="OnAddressKeyDown"
                                 Watermark="输入 Repository 路径，按 Enter 跳转" ToolTip.Tip="输入路径并按 Enter 跳转 (Ctrl / ⌘ + L)"
                                 AutomationProperties.Name="Repository 路径" />
                        <TextBlock Grid.Column="2" Text="索引操作不会移动磁盘文件" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
