<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HDD_Index.ViewModels"
        x:Class="HDD_Index.Views.AbandonDeclareHoldingDialog"
        x:DataType="vm:AbandonDeclareHoldingDialogViewModel"
        Classes="dialog" Title="解除关联"
        Width="600" Height="440" MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="16" Margin="24,24,24,18">
            <Path Width="32" Height="32" Stretch="Uniform" Stroke="{DynamicResource WorkspaceMuted}" StrokeThickness="1.6" VerticalAlignment="Top" Data="M 10,14 L 14,10 M 8,16 L 6,18 C 2,22 -2,16 2,12 L 6,8 C 9,5 12,7 13,9 M 16,8 L 18,6 C 22,2 26,8 22,12 L 18,16 C 15,19 12,17 11,15" />
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Classes="dialog-title" Text="选择要解除的关联" TextWrapping="Wrap" />
                <TextBlock Classes="secondary" Text="当前磁盘节点关联的虚拟目录" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="24,0,24,20"><Grid RowDefinitions="*,Auto" RowSpacing="14">
            <Border BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AbandonDeclareHoldingOption">
                            <Border Padding="14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WorkspaceBorder}">
                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding RepoNodePath}" TextWrapping="Wrap" />
                                </CheckBox>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock Grid.Row="1" Classes="secondary" Text="仅解除索引关联，不删除任何文件。" TextWrapping="Wrap" />
        </Grid></Grid>
        <Border Grid.Row="2" Classes="dialog-footer">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="取消" IsCancel="True" Command="{Binding CancelCommand}" />
                <Button Content="解除所选关联" Classes="danger" Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
