<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HDD_Index.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="320"
        x:Class="HDD_Index.Views.AbandonDeclareHoldingDialog"
        x:DataType="vm:AbandonDeclareHoldingDialogViewModel"
        Title="放弃声明持有"
        Width="520" Height="320"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:AbandonDeclareHoldingDialogViewModel />
    </Design.DataContext>

    <Grid Margin="14" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="请选择要放弃声明持有的 Repository 节点："
                   TextWrapping="Wrap" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Options}"
                 Margin="0,12,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AbandonDeclareHoldingOption">
                    <CheckBox Content="{Binding RepoNodePath}"
                              IsChecked="{Binding IsSelected}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Command="{Binding CancelCommand}" />
            <Button Content="确定"
                    Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</Window>
