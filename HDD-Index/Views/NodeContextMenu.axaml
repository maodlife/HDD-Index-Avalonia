<ContextMenu xmlns="https://github.com/avaloniaui"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:vm="using:HDD_Index.ViewModels"
     x:Class="HDD_Index.Views.NodeContextMenu"
     x:DataType="vm:MainWindowViewModel">
    <ContextMenu.Resources>
        <vm:NodeTypeToVisibilityConverter x:Key="NodeTypeConverter" />
        <vm:RepoNodeOnlyVisibilityConverter x:Key="RepoNodeOnlyConverter" />
        <vm:FileNodeOnlyVisibilityConverter x:Key="FileNodeOnlyConverter" />
        <vm:FileDirectoryNodeOnlyVisibilityConverter x:Key="FileDirectoryNodeOnlyConverter" />
        <vm:FileNodeCanJumpVisibilityConverter x:Key="FileNodeCanJumpConverter" />
        <vm:RepoDirectoryEditModeVisibilityConverter x:Key="RepoDirectoryEditModeConverter" />
    </ContextMenu.Resources>
    <MenuItem Header="输出路径到日志"
              Command="{Binding RepositoryEditor.LogNodePathCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}" />
    <MenuItem Header="展开到保存节点"
              Command="{Binding RepositoryEditor.ExpandToSavedNodeCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}" />
    <MenuItem Header="在文件夹中打开"
              Command="{Binding RepositoryEditor.OpenFileNodeInFolderCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsEnabled="{Binding FileBrowser.HasCurrentLocalFolderPath}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource FileNodeOnlyConverter}}" />
    <MenuItem Header="读取文件夹并刷新"
              Command="{Binding RepositoryEditor.RefreshFileNodeFromLocalFolderCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsEnabled="{Binding FileBrowser.HasCurrentLocalFolderPath}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource FileDirectoryNodeOnlyConverter}}" />
    <MenuItem Header="读取文件夹并刷新（跳过已保存）"
              Command="{Binding RepositoryEditor.RefreshFileNodeFromLocalFolderSkippingDeclaredCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsEnabled="{Binding FileBrowser.HasCurrentLocalFolderPath}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource FileDirectoryNodeOnlyConverter}}" />
    <MenuItem Header="跳转"
              Command="{Binding RepositoryEditor.JumpToDeclareRepoNodeCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource FileNodeCanJumpConverter}}" />
    <MenuItem Header="声明持有左侧选中的节点"
              Command="{Binding RepositoryEditor.DeclareSelectedRepoNodeCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource FileNodeOnlyConverter}}" />
    <MenuItem Header="放弃声明持有"
              Command="{Binding RepositoryEditor.AbandonDeclareHoldingCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource FileNodeCanJumpConverter}}" />
    <MenuItem Header="创建子文件夹"
              Command="{Binding RepositoryEditor.CreateChildFolderCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource NodeTypeConverter}}" />
    <MenuItem Header="拷贝右侧选中的结点"
              Command="{Binding RepositoryEditor.CopySelectedFileNodeToRepoNodeCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsEnabled="{Binding FileBrowser.HasSelectedFileNode}">
        <MenuItem.IsVisible>
            <MultiBinding Converter="{StaticResource RepoDirectoryEditModeConverter}">
                <Binding Path="$parent[TreeDataGrid].RowSelection.SelectedItem" />
                <Binding Path="ViewModeTabIndex" />
            </MultiBinding>
        </MenuItem.IsVisible>
    </MenuItem>
    <MenuItem Header="验证策略"
              IsEnabled="{Binding !IsStrategyChangeRunning}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource RepoNodeOnlyConverter}}">
        <MenuItem Header="未设置" Command="{Binding RepositoryEditor.ClearStrategyCommand}"
                  CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}" />
        <MenuItem Header="默认" Command="{Binding RepositoryEditor.UseDefaultStrategyCommand}"
                  CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}" />
        <MenuItem Header="BDRip" Command="{Binding RepositoryEditor.UseBDRipStrategyCommand}"
                  CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}" />
    </MenuItem>
    <MenuItem Header="搜索并删除节点"
              Command="{Binding RepositoryEditor.SearchAndDeleteRepoNodesCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource RepoNodeOnlyConverter}}" />
    <MenuItem Header="重命名"
              Command="{Binding RepositoryEditor.RenameRepoNodeCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource RepoNodeOnlyConverter}}" />
    <MenuItem Header="删除"
              Command="{Binding RepositoryEditor.DeleteRepoNodeCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource RepoNodeOnlyConverter}}" />
    <MenuItem Header="删除"
              Command="{Binding RepositoryEditor.DeleteFileNodeCommand}"
              CommandParameter="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem}"
              IsVisible="{Binding $parent[TreeDataGrid].RowSelection.SelectedItem,
                          Converter={StaticResource FileNodeOnlyConverter}}" />
</ContextMenu>
