<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HDD_Index.ViewModels"
        x:Class="HDD_Index.Views.RenameRepoNodeDialog"
        x:DataType="vm:RenameRepoNodeDialogViewModel" Classes="dialog"
        Title="重命名" Width="540" Height="270"
        MinWidth="540" MinHeight="270" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto">
        <StackPanel Margin="24">
            <Grid ColumnDefinitions="40,*" ColumnSpacing="16" Margin="0,0,0,24">
                <Path Data="M2,5 L9,5 L12,8 L22,8 L22,21 L2,21 Z" Stroke="{DynamicResource WorkspaceMuted}" StrokeThickness="1.5"
                      Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="重命名虚拟节点" Classes="dialog-title" />
                    <TextBlock Text="仅修改虚拟目录，不影响磁盘文件。" Classes="secondary" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <TextBlock Text="名称" Margin="0,0,0,8" />
            <TextBox Text="{Binding NameText}" Watermark="新名称" AutomationProperties.Name="名称" />
        </StackPanel>
        <Border Grid.Row="1" Classes="dialog-footer">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="取消" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Content="保存名称" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" Classes="primary" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
