<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HDD_Index.ViewModels"
        x:Class="HDD_Index.Views.UnsavedChangesDialog"
        x:DataType="vm:UnsavedChangesDialogViewModel"
        Classes="dialog" Title="未保存的修改"
        Width="600" Height="370" MinWidth="540" MinHeight="330"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="40,*" ColumnSpacing="16" Margin="24,24,24,18">
            <Path Width="32" Height="32" Stretch="Uniform" Stroke="{DynamicResource WorkspaceMuted}" StrokeThickness="1.6" VerticalAlignment="Top" Data="M 6,2 L 14,2 L 20,8 L 20,22 L 6,22 Z M 14,2 L 14,8 L 20,8" />
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Classes="dialog-title" Text="退出前保存更改？" TextWrapping="Wrap" />
                <TextBlock Classes="secondary" Text="{Binding MessageText}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="24,0,24,20"><Border Classes="dialog-note">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DirtyFilePaths}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border></Grid>
        <Border Grid.Row="2" Classes="dialog-footer">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="不保存并退出" Command="{Binding ExitWithoutSavingCommand}" />
                <Button Content="取消" IsCancel="True" Command="{Binding CancelCommand}" />
                <Button Content="保存并退出" Classes="primary" IsDefault="True" Command="{Binding SaveAndExitCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
